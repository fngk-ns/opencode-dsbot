[Unit]
Description=opencode Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
__USER_LINE__
WorkingDirectory=__DIR__
EnvironmentFile=__DIR__/.env
Environment="PATH=__PATH__"
# deploy/run.sh restarts the bot after self-modification and rolls back a version that cannot start.
ExecStart=__DIR__/deploy/run.sh
Restart=always
RestartSec=5
TimeoutStopSec=20
# Deployed services run detached from the bot so they survive bot restarts. With the default KillMode systemd would kill
# every process in the unit when the bot is stopped, services included, so only the main process is signalled.
KillMode=process
# The agent manages this computer on purpose, so the unit is deliberately not sandboxed.
# Run it as a dedicated, least-privileged user if you do not want it to touch your own files.

[Install]
WantedBy=__WANTED_BY__
