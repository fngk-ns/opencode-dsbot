# ---- required -------------------------------------------------------------
DISCORD_TOKEN=your-bot-token
# Comma separated Discord user IDs. Owners can use /self, approve permissions and restarts.
# The agent can run shell commands on this machine, so there is no "everyone" mode.
DISCORD_OWNER_IDS=123456789012345678

# ---- who may use the bot --------------------------------------------------
# Extra users who may talk to the bot (owners are always allowed).
DISCORD_USER_IDS=
# Restrict to these servers (empty = every server the bot is in).
DISCORD_GUILD_IDS=

# ---- opencode -------------------------------------------------------------
# Command that starts opencode. The bot appends: serve --hostname=127.0.0.1 --port=0
OPENCODE_CMD=opencode
# Model provider credentials are read by opencode from the environment. For Claude, use an Anthropic API key
# (console.anthropic.com). `opencode auth login` on the host works for other providers too.
ANTHROPIC_API_KEY=
# provider/model used when nothing else is chosen, for example anthropic/claude-sonnet-4-6 (empty = opencode default).
# People can switch per conversation from Discord: "@bot claude sonnet 모델로 바꿔줘" or "/model sonnet".
OPENCODE_MODEL=
OPENCODE_AGENT=
# ask  = edit/bash need an owner click on a Discord button
# auto = the agent may edit files and run commands without asking
PERMISSION_MODE=ask

# ---- folders ----------------------------------------------------------------
# Projects live in WORKSPACE_DIR/<name> (default project: "default").
WORKSPACE_DIR=~/opencode-workspace
# SQLite database with the message cache and thread->session bindings.
DATA_DIR=
# Source the /self session edits. Default: this package.
SELF_DIR=

# ---- self modification --------------------------------------------------------
# confirm = an owner clicks "restart" after check/test pass
# auto    = restart right after check/test pass
SELF_RESTART=confirm

# ---- limits -----------------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_DOWNLOAD_MB=25
# 0 = keep cached messages forever
MESSAGE_RETENTION_DAYS=0
# Cap on explicit message-link/ID lookups that miss the cache (the only REST message reads).
REST_LOOKUPS_PER_MINUTE=20
